# Copie este arquivo para .env.local e preencha os valores.
# NUNCA faça commit do .env.local: ele já está no .gitignore.

# --- Públicas (aparecem no navegador; não coloque segredos aqui) ---
NEXT_PUBLIC_SITE_URL=https://nexoraai-br.netlify.app
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CNPJ=

# Supabase: URL e chave PUBLICÁVEL (sb_publishable_...). A segurança vem das regras RLS do banco.
# A chave service_role/secret NUNCA vai para o site.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Secretas (somente servidor) — próxima etapa ---
# Mercado Pago (assinaturas): será adicionada quando implementada.
