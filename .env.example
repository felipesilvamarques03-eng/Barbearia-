# Copie este arquivo para .env.local e preencha os valores.
# NUNCA faça commit do .env.local: ele já está no .gitignore.

# --- Públicas (aparecem no navegador; não coloque segredos aqui) ---
NEXT_PUBLIC_SITE_URL=https://nexora.com.br
NEXT_PUBLIC_WHATSAPP_NUMBER=5511900000000
NEXT_PUBLIC_CONTACT_EMAIL=contato@nexora.com.br
NEXT_PUBLIC_CNPJ=

# --- Secretas (somente servidor) ---
# Chave do Resend (https://resend.com) para enviar o formulário de contato.
RESEND_API_KEY=
# Remetente verificado no Resend, ex.: "NEXORA Site <site@nexora.com.br>"
CONTACT_FROM_EMAIL=
# Caixa que recebe os contatos
CONTACT_TO_EMAIL=
